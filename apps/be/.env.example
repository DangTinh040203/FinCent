NODE_ENV=development
PORT=8000
API_PREFIX=api
FE_URL=http://localhost:3001

# --- Database (Postgres) ---
# dev: docker-compose.dev.yml provisions postgres on localhost:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fincent_db

# --- Cache (Redis) ---
# dev: redis://localhost:6379 (docker-compose.dev.yml) · prod: redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=fincent

# --- Clerk auth ---
# Dashboard → API Keys. The webhook secret comes from the Clerk webhook
# endpoint you point at POST /api/v1/users/clerk (Dashboard → Webhooks → Signing Secret).
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
